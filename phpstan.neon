includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
    level: 5
    ignoreErrors:
        # Eloquent model properties - handled by $fillable/$casts
        - '#Access to an undefined property App\\Modules\\.*\\Infrastructure\\Models\\.*::\$#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$#'
        # Eloquent relations return types
        - '#should return App\\Modules\\.*\\Infrastructure\\Models\\.* but returns Illuminate\\Database\\Eloquent\\Model\|null#'
        # Collection map callbacks
        - '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection.*::map\(\) contains unresolvable type#'
        - '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection.*::map\(\) expects callable#'
        # HasMany scope methods
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\HasMany::#'
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::#'
        # M8-VERIFY: removed the blanket "Filament classes (version
        # compatibility)" ignore for '#Call to static method make() on an
        # unknown class Filament\#' — that rule was masking the exact
        # Filament 5 migration bugs fixed this session (Filament\Tables\
        # Actions\* should be Filament\Actions\*, Filament\Schemas\
        # Components\{TextInput,Select,...} should be Filament\Forms\
        # Components\*, Filament\Schemas\Components\TextEntry should be
        # Filament\Infolists\Components\TextEntry) instead of surfacing
        # them. Now that the imports are correct, PHPStan reports the
        # ignore as unused — leaving it in would silently re-mask any
        # future recurrence of the same mistake.
        # M10.6: removed the '#...unknown class Barryvdh\DomPDF\Facade\Pdf#'
        # ignore added while barryvdh/laravel-dompdf wasn't installed yet —
        # now that it is, PHPStan resolves the class fine and flags the
        # ignore as unused.
        # Nullsafe on relations (false positive)
        - '#Using nullsafe property access.*on left side of \?\? is unnecessary#'
        # SoftDeletes scope on Builder
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder.*::withTrashed\(\)#'
        # Type covariance with auth()->user()
        -
            message: '#expects App\\Modules\\Identity\\Infrastructure\\Models\\User, Illuminate\\Database\\Eloquent\\Model\|null given#'
            reportUnmatched: false
    excludePaths:
        - app/Modules/*/Infrastructure/Migrations/*
